#!/usr/bin/env bash
# Pre-commit hook: reject backup files and debug statements in staged files
#
# ┌─ Backup-file check ────────────────────────────────────────────────────────
# │  Scope: DIRECTORY-RESTRICTED — only app/, resources/, public/, database/
# │  Patterns: *.bak, *.bak_*, *.orig, *.tmp, "* copy.*", "* copy" (no ext)
# └────────────────────────────────────────────────────────────────────────────
#
# ┌─ Debug-statement check ────────────────────────────────────────────────────
# │  Scope: ALL staged files — intentionally NOT directory-scoped.
# │         Covers app/, config/, routes/, tests/, resources/, and any other
# │         location.  Do NOT add directory filters here; debug statements must
# │         be caught wherever they appear.
# │
# │  ADDED LINES ONLY.  The check judges the lines this commit ADDS, not the
# │         whole content of the files it touches.  Editing one line in a file
# │         that already contains debug statements is not an offence, and used
# │         to be treated as one — which meant the only way to commit was to
# │         clean up code the change never touched.  Adding a debug statement
# │         is still blocked, wherever in the file it lands.
# │
# │  File types in scope:
# │    PHP group   — *.php (includes *.blade.php, config/*.php, routes/*.php,
# │                          tests/**/*.php, and any other .php file)
# │    JS group    — *.js, *.mjs, *.jsx (plain JS, ES-module scripts, React JSX)
# │    TS group    — *.ts, *.tsx       (TypeScript and React TSX)
# │    Vue/Svelte  — *.vue, *.svelte   (single-file components)
# │    Templates   — *.twig            (Twig templates; uses dump() for debug)
# │
# │  Debug patterns checked:
# │    PHP/Twig  : dd(, var_dump(, dump(
# │    JS/TS/Vue : console.log(, debugger;
# │
# │  The extension lists and patterns above now live in ONE place — the
# │  "pre-commit" profile inside scripts/ci/check-added-debug-statements.sh —
# │  shared with the two CI workflows.  Each gate keeps its OWN profile: the
# │  three sets differ on purpose and were not harmonised.
# │
# │  To add a new file type in the future:
# │    1. Identify which debug patterns are relevant for that type.
# │    2. Add the extension to the "pre-commit" profile in the shared checker.
# │    3. Update the "File types in scope" list in this header comment.
# └────────────────────────────────────────────────────────────────────────────
#
# To bypass intentionally: git commit --no-verify

set -euo pipefail

# ── Backup-file check (directory-scoped) ──────────────────────────────────────
# Only the directories below are scanned for backup files.  This is deliberate:
# backup-file pollution is most harmful in source directories that Laravel's
# autoloader, migration scanner, and asset pipeline traverse automatically.
BACKUP_DIRS="app resources public database"

BAK_PATTERN='\.(bak|bak_.+|orig|tmp)$| copy(\.[^/]+)?$'

backup_found=()

for dir in $BACKUP_DIRS; do
    while IFS= read -r -d '' file; do
        if echo "$file" | grep -qiE "$BAK_PATTERN"; then
            backup_found+=("$file")
        fi
    done < <(git diff --cached --name-only --diff-filter=ACMR -z -- "$dir/" 2>/dev/null || true)
done

if [ ${#backup_found[@]} -gt 0 ]; then
    echo ""
    echo "ERROR: Backup files detected in your commit:"
    echo ""
    for f in "${backup_found[@]}"; do
        echo "  $f"
    done
    echo ""
    echo "Please remove or rename these files before committing."
    echo "Backup files (*.bak, *.bak_*, *.orig, *.tmp, '* copy.*') must not be committed."
    echo "These extensions can confuse Laravel's migration scanner and other tooling."
    echo "If you intended to commit a renamed/cleaned version, rename the file"
    echo "to its final name first, then stage and commit it."
    echo ""
    exit 1
fi

# ── Debug-statement check (ALL staged files — no directory restriction) ────────
# This check is intentionally unrestricted by directory.  Debug statements are
# harmful anywhere in the codebase, including test files.  Do NOT add a DIRS
# filter or path prefix here — doing so would silently allow debug statements
# through in any file outside those directories (e.g. tests/, routes/, etc.).
#
# The scan itself is delegated to the shared, diff-aware checker so that the
# hook and the two CI workflows cannot drift apart in HOW they read a change.
# WHAT each of them prohibits stays separate: this hook selects the "pre-commit"
# profile, whose patterns and extensions are exactly the ones documented above.

REPO_ROOT="$(git rev-parse --show-toplevel)"
DEBUG_GATE="$REPO_ROOT/scripts/ci/check-added-debug-statements.sh"

if [ ! -f "$DEBUG_GATE" ]; then
    # Fail closed.  A missing checker means the commit was never inspected, and
    # an uninspected commit must not be indistinguishable from a clean one.
    echo ""
    echo "ERROR: debug-statement checker not found:"
    echo ""
    echo "  $DEBUG_GATE"
    echo ""
    echo "The pre-commit hook cannot verify this commit and is refusing rather"
    echo "than letting it through unchecked."
    echo "If this is intentional, bypass with: git commit --no-verify"
    echo ""
    exit 1
fi

# Exit status is passed through unchanged: 1 = debug statements were added,
# 2 = the check could not be performed.  Both block the commit, and the
# difference is preserved so a broken gate is not misread as a dirty commit.
set +e
bash "$DEBUG_GATE" --profile pre-commit --staged
debug_gate_status=$?
set -e

if [ "$debug_gate_status" -ne 0 ]; then
    exit "$debug_gate_status"
fi

exit 0
