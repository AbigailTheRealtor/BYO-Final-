modules = ["php-8.2", "web", "nodejs-20", "python-3.11", "postgresql-16"]
disableInstallBeforeRun = true
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["unzip", "orbiton"]

[userenv]

[userenv.shared]
# APP_URL / ASSET_URL are deliberately NOT declared here.
#
# Shared userenv reaches deployments as well as development shells, and
# Illuminate\Support\Env builds an IMMUTABLE repository - a value already in the
# process environment beats the same key in `.env`. Declaring a *.replit.dev
# workspace host here therefore forced every production asset, mail and console
# URL onto the development workspace, which is reachable only while that
# workspace is awake.
#
# Absent is the correct value, not a placeholder. With ASSET_URL unset,
# UrlGenerator::asset() falls back to the live request root, so assets resolve
# against whatever host actually served the page. Do not substitute a guessed
# production hostname; if a deployment ever needs an explicit one, set it as a
# deployment-scoped variable, never here.
#
# ProductionUrlIsolationTest pins this.
DB_CONNECTION = "pgsql"
DB_HOST = "helium"
DB_PORT = "5432"
DB_DATABASE = "heliumdb"
DB_USERNAME = "postgres"
DB_PASSWORD = "password"
APP_NAME = "BidYourOffer"
CACHE_DRIVER = "file"
SESSION_DRIVER = "file"
QUEUE_CONNECTION = "sync"
BROADCAST_DRIVER = "log"

[userenv.development]
ASK_AI_ENABLE_OPENAI_INTENT_NORMALIZATION = "true"
OPENAI_MODEL = "gpt-4o-2024-08-06"
OPENAI_PROMPT_VERSION = "property-dna-report-v1.0"
MAIL_MAILER = "log"
ASK_AI_ENABLE_DESCRIPTION_FALLBACK = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Laravel Server"

[[workflows.workflow]]
name = "Laravel Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/.worktrees/production-serve && bash deploy/start-serving.sh"
waitForPort = 5000

[deployment]
deploymentTarget = "vm"
run = ["bash", "deploy/start-production.sh"]
build = ["composer", "install", "--no-dev", "--optimize-autoloader", ";", "npm", "install", ";", "npm", "run", "prod", ";", "php", "artisan", "route:cache", ";", "php", "artisan", "view:cache"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000
