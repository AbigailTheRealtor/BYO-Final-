APP_NAME=Laravel
# Local development defaults below. IN PRODUCTION you MUST set:
#   APP_ENV=production   APP_DEBUG=false   SESSION_SECURE_COOKIE=true
# Leaving APP_ENV=local / APP_DEBUG=true in a deployment leaks stack traces
# and enables local-only debug routes.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Local-only developer auto-login route (/dev-login/{id}). MUST stay false in
# any deployment. Ignored entirely in the production environment.
DEV_LOGIN_ENABLED=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bidoffer
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set to true in production (HTTPS) so the session cookie is marked Secure.
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------
# Mail Configuration
# -----------------------------------------------------------------------
# Development: use MAIL_MAILER=log to write all outgoing mail to
# storage/logs/laravel.log — no mail server required, no 500 errors.
#
# Production: set MAIL_MAILER=smtp and supply real SMTP credentials via
# Replit environment secrets (or your host's secret manager). Example
# providers: Mailgun, SendGrid, Postmark, AWS SES, or any SMTP relay.
#
# Required production secrets:
#   MAIL_MAILER      = smtp
#   MAIL_HOST        = smtp.mailgun.org  (or your provider's host)
#   MAIL_PORT        = 587               (or 465 for SSL)
#   MAIL_USERNAME    = (your SMTP username / API key)
#   MAIL_PASSWORD    = (your SMTP password / API secret)
#   MAIL_ENCRYPTION  = tls               (or ssl)
#   MAIL_FROM_ADDRESS= noreply@yourdomain.com
#   MAIL_FROM_NAME   = "Bid Your Offer"
# -----------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@bidyouroffer.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# R2-D.4: dedicated public-media bucket. Optional — falls back to AWS_BUCKET
# when unset, preserving prior single-bucket behavior.
AWS_PUBLIC_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Optional: set only for S3-compatible endpoints (leave empty for real AWS S3).
AWS_ENDPOINT=
AWS_URL=

# -----------------------------------------------------------------------
# R2-A (HI-05A) listing-storage disk selectors — INERT by default.
# Leave on the local disks ('public'/'private'). A later phase flips these
# to 's3_public'/'s3_private' to activate object storage.
# -----------------------------------------------------------------------
LISTING_PUBLIC_DISK=public
LISTING_PRIVATE_DISK=private
# Gate for the explicitly-invoked, read-only `php artisan s3:preflight` check.
STORAGE_S3_PREFLIGHT_ENABLED=false

# R2-B.1 (HI-05A) temporary dual-write — INERT by default. When true, new listing
# writes are mirrored best-effort to the object-storage secondary disks below;
# local stays authoritative. Do not enable until the private bucket is confirmed
# private. Existing files are NOT migrated by this flag.
STORAGE_DUAL_WRITE=false
LISTING_PRIVATE_SECONDARY_DISK=s3_private
LISTING_PUBLIC_SECONDARY_DISK=s3_public

# -----------------------------------------------------------------------
# Google Maps / Places API
# Required for address autocomplete (seller, landlord, /offers/87, /offers/88)
# and the drawing map (buyer, tenant). Without this key, address fields will
# not autocomplete and property-preference maps will not render.
#
# Set the key value in .env (NOT only as a Replit platform secret — the
# Laravel workflow process reads from .env via phpdotenv at startup; Replit
# platform secrets are not injected into the workflow process environment).
#
# Enable in Google Cloud Console:
#   - Maps JavaScript API
#   - Places API
# -----------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# Server-side Google Places NEARBY SEARCH (Location DNA POIs) — master switch.
# OFF by default. ON only for `true`, `1`, `on`, `yes`; unset, empty, `false`,
# `0`, `off`, `no` and ANY other value are OFF. It does not govern address
# autocomplete. Server-side geocoding has its own switch below; the Location DNA
# geocode step and the geocode backfill command require BOTH.
GOOGLE_PLACES_ENABLED=false

# HARD Nearby Search request ceilings, enforced before each request is sent by
# the shared admission middleware on the server's Google HTTP client: one unit
# per outbound request, a cache hit costs nothing, a retry is admitted again.
# Request 26 in a UTC clock hour and 101 in a UTC day are refused without
# reaching Google. A zero or malformed value blocks Nearby Search entirely.
# Autocomplete is NOT budgeted, Geocoding has its own ceilings below, and
# browser-side Google is not governed by the server at all. Keep Google Cloud
# quotas and billing alerts as well — these are a backstop, not the only brake.
GOOGLE_PLACES_HOURLY_LIMIT=25
GOOGLE_PLACES_DAILY_LIMIT=100

# Server-side Google GEOCODING (maps/api/geocode/json) — its own master switch,
# separate from GOOGLE_PLACES_ENABLED. OFF by default, parsed the same strict way:
# ON only for `true`, `1`, `on`, `yes`; anything else is OFF. A present
# GOOGLE_PLACES_API_KEY is NOT permission to geocode. Off means zero Geocoding
# requests: Tenant address pickers leave city / state / ZIP / county for the
# user to fill in, and Location DNA records the coordinate as unresolved.
GOOGLE_GEOCODING_ENABLED=false

# HARD Geocoding request ceilings — their OWN allowance, independent of the
# Nearby Search ceilings above (spending one never spends the other). One unit
# per outbound Geocoding request, admitted before it is sent; a stored or cached
# coordinate costs nothing; a retry is admitted again. Request 26 in a UTC clock
# hour and 101 in a UTC day are refused without reaching Google. A zero or
# malformed value blocks Geocoding entirely.
GOOGLE_GEOCODING_HOURLY_LIMIT=25
GOOGLE_GEOCODING_DAILY_LIMIT=100

# -----------------------------------------------------------------------
# Realtime broadcasting (Laravel Echo / Pusher) — OFF, and unconfigured.
#
# Nothing here is wired up: BROADCAST_DRIVER is `log` above, these credentials
# are blank, and no front-end feature depends on realtime (the notification bell
# renders from the database and refreshes by fetch). Leave it that way unless you
# are deliberately turning realtime on.
#
# To turn it on you need FOUR things, and each is load-bearing:
#   1. BROADCAST_DRIVER=pusher          (so events actually reach Pusher)
#   2. the three PUSHER_APP_* values below
#   3. PUSHER_APP_CLUSTER matching the app the key belongs to
#   4. BROADCAST_CLIENT_ENABLED=true    (the explicit browser opt-in)
#
# BROADCAST_CLIENT_ENABLED is what lets a page construct Echo and open a socket.
# It is deliberately separate from the credentials: putting a key in the
# environment while experimenting must not, by itself, start opening WebSockets
# for every visitor. The browser reads the key from the rendered page, from these
# same variables at request time — so there is no build-time copy to go stale.
#
# There were MIX_PUSHER_APP_KEY / MIX_PUSHER_APP_CLUSTER lines here. Nothing reads
# them any more, and they were worse than merely dead. Laravel Mix 6 does run
# dotenv-expand, so `"${PUSHER_APP_KEY}"` did resolve — to the EMPTY STRING, given
# the blank default above. The bundle's `process.env.MIX_PUSHER_APP_KEY || '<key>'`
# fallback then took over and shipped a hardcoded third-party app key. Beyond that,
# any MIX_ variable is frozen into the bundle when assets are built, while the
# server reads its own copy per request: two sources for one value, on a host where
# the build and the runtime environment are not the same thing.
# -----------------------------------------------------------------------
BROADCAST_CLIENT_ENABLED=false
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Ask AI — Feature Flags
# Enable OpenAI intent normalization for dev/staging. Production default is false (governed).
ASK_AI_ENABLE_OPENAI_INTENT_NORMALIZATION=true

# BYA Compatibility Hidden Beta
BYA_COMPATIBILITY_HIDDEN_BETA_ENABLED=false

# BYA Compatibility Consumer Beta (Milestone 14)
BYA_COMPATIBILITY_CONSUMER_BETA_ENABLED=false

# BYA Compatibility General Availability controls (Milestone 15)
# Kill switch: true = all consumer access denied immediately (safe default)
BYA_COMPATIBILITY_KILL_SWITCH=true
# GA feature flag: false = GA path inactive (independent of consumer beta)
BYA_COMPATIBILITY_GA_ENABLED=false
# Rollout percentage 0–100: deterministic bucket crc32(user_id)%100 < value
BYA_COMPATIBILITY_ROLLOUT_PERCENTAGE=0
# Allowlist (JSON array): users always granted GA access e.g. [1,2,3]
BYA_COMPATIBILITY_ALLOWED_USER_IDS=[]

# Agent AI Assistant V2
# When true, POST /agent-ai/ask and POST /agent-ai/session/start are active (placeholder JSON).
# When false (default), those routes return 404. V1 Ask AI is never affected by this flag.
# GOVERNANCE REVIEW REQUIRED before enabling in production.
AGENT_AI_ASSISTANT_V2=false

# -----------------------------------------------------------------------
# Bridge Integration
# Required for the Bridge MLS data API. Set both values via your host's
# secret manager (Replit environment secrets in production).
#   BRIDGE_DATASET       — the dataset identifier, e.g. "stellar"
#   BRIDGE_SERVER_TOKEN  — your private server-side API token (keep secret)
# -----------------------------------------------------------------------
BRIDGE_DATASET=
BRIDGE_SERVER_TOKEN=

# Lazy-import cache TTL — how many minutes a criteria fetch-cache entry is
# considered fresh before the next search triggers a new Bridge API pull.
BRIDGE_LAZY_TTL_MINUTES=60

# Hard pagination caps for a single lazy-fetch cycle.
# If either limit is reached, pagination stops, a warning is logged, and
# the partial result set is still upserted and cached.
#   BRIDGE_LAZY_MAX_PAGES   — maximum API pages per cycle (each page ≤ 200 records)
#   BRIDGE_LAZY_MAX_RECORDS — maximum total records upserted per cycle
BRIDGE_LAZY_MAX_PAGES=20
BRIDGE_LAZY_MAX_RECORDS=500
# Number of records per API page (Bridge API maximum is 200).
BRIDGE_LAZY_PAGE_SIZE=200
# TTL (minutes) for partial imports (when a max-pages/max-records cap is hit).
# Shorter than BRIDGE_LAZY_TTL_MINUTES so the next request retries sooner.
# Set to 0 to skip caching partial results (forces re-fetch every time).
BRIDGE_LAZY_PARTIAL_TTL_MINUTES=5

# ─── BidYourOffer Explore ────────────────────────────────────────────────────
#
# Public IDX discovery surface: a Google Photorealistic 3D neighbourhood with
# eligible Stellar FOR SALE and FOR RENT listings placed at their own MLS
# coordinates. Ships OFF; with the master flag off every Explore route 404s,
# including the data endpoints.
EXPLORE_ENABLED=false

# The VOW / Property Intelligence tier. SEPARATE from the master flag, and
# turning it on grants nothing: no VOW approval, dataset, credential or consumer
# registration flow exists in this application, and App\Services\Explore\Vow\
# VowAvailability refuses regardless of this value. See
# docs/bidyouroffer-explore-audit-2026-09-10.md for what activation would require.
EXPLORE_VOW_ENABLED=false

# Google Maps JavaScript API BROWSER key for the photorealistic 3D renderer.
#
# NOT GOOGLE_PLACES_API_KEY. That is a server key used by address validation and
# POI lookup; it must never be emitted into a page and is never a fallback here.
# Absent by default — with no key, /explore serves and renders a stated
# unavailable panel, and issues no Google request at all.
#
# Only the `maps3d` library is requested. No Places, Routes, Roads, Directions or
# Geocoding: markers are placed from MLS coordinates, which are authoritative.
EXPLORE_GOOGLE_MAPS_BROWSER_KEY=
# Optional styled Map ID. Photorealistic tiles render without one.
EXPLORE_GOOGLE_MAPS_MAP_ID=
EXPLORE_GOOGLE_MAPS_VERSION=alpha

# Opening camera. Defaults to St. Petersburg / Tampa Bay, where this dataset's
# inventory actually is — opening anywhere else shows an empty neighbourhood.
EXPLORE_DEFAULT_LAT=27.7676
EXPLORE_DEFAULT_LNG=-82.6403
EXPLORE_DEFAULT_ALTITUDE=900
EXPLORE_DEFAULT_TILT=67.5
EXPLORE_DEFAULT_HEADING=0
EXPLORE_DEFAULT_RANGE=2500

# Viewport limits. max_results bounds one response; max_span_degrees refuses a
# bounding box large enough to be a dataset scrape rather than a neighbourhood
# (a refusal, never a silent clamp).
EXPLORE_MAX_RESULTS=150
EXPLORE_MAX_SPAN_DEGREES=1.0

# Viewport discovery — CURRENT Stellar inventory.
#
# Without this, Explore renders only the Stellar records some earlier workflow
# happened to import, so a neighbourhood nobody had searched looks empty — a
# statement about our cache presented as a statement about the market.
#
# With it, a viewport request asks the application's ONE existing MLS ingestion
# pipeline (LazyBridgeImportService: the same advisory lock, fetch cache,
# pagination and normalizer the criteria searches use) for the current eligible
# listings in that area. Explore adds no client, no importer and no storage of
# its own — and it opts OUT of the importer's Location DNA dispatch, whose POI
# step can call Google Places.
#
# SHIPS FALSE, like MLS_SYNC_ENABLED and for the same reason: deploying code
# must not by itself begin unattended traffic to a third-party provider.
# Requires Bridge credentials (see BRIDGE_DATASET / BRIDGE_SERVER_TOKEN).
# ON only for `true`, `1`, `on`, `yes`; anything else — `off`, `no`, a typo —
# is OFF.
EXPLORE_DISCOVERY_ENABLED=false

# Grid the discovery bbox is snapped OUTWARDS to before it is hashed into a
# fetch-cache key. This is what makes cache reuse real: unsnapped, the key
# changes with every pixel of pan and every camera nudge becomes a request.
EXPLORE_DISCOVERY_TILE_DEGREES=0.05

# Per-pass pagination ceilings, clamped DOWNWARDS against BRIDGE_LAZY_* by the
# importer — a call site may lower a spend limit, never raise one.
EXPLORE_DISCOVERY_MAX_PAGES=5
EXPLORE_DISCOVERY_MAX_RECORDS=500

# Provider request budget — a HARD ceiling on what Explore can SPEND.
#
# The unit is ONE outbound Bridge HTTP request: one OData page of a discovery
# pass, or the property panel's single-record lookup. A cache hit costs nothing.
# Each request is admitted — checked and charged against both ceilings under one
# lock — immediately BEFORE it is sent, so a configured 60 admits exactly 60 and
# a pass that runs out part-way stops before its next page.
#
# `throttle:120,1` on the data routes bounds REQUESTS, not provider spend: one
# unfiltered viewport request can cost up to five provider pages per transaction
# type. Tile snapping and the fetch cache make REPEAT visits free; these
# ceilings bound DISTINCT ones.
#
# All accounting is the existing provider-neutral ProviderRequestBudget, asked
# at two scopes. No second budget system exists.
#
# There is no way to configure "unlimited": a zero, negative or non-numeric
# value falls back to the shipped default rather than to no ceiling.
EXPLORE_PROVIDER_BUDGET_ENABLED=true

# Emergency stop for Explore's outbound Stellar/Bridge traffic, leaving the rest
# of Explore and the whole application serving. Set at 2am, not as a rollout dial.
#
# FAILS SAFE. Tripped: `true`, `1`, `on`, `yes` — and ANY unrecognised value.
# Not tripped: unset, empty, `false`, `0`, `off`, `no`.
EXPLORE_PROVIDER_KILL_SWITCH=false

# Ceiling across every caller — the bill's backstop, and the one that catches
# traffic no per-caller limit can see.
#
# Deliberately conservative for a controlled launch. These are APPLICATION-side
# Explore ceilings, not a statement of Stellar's provider allowance, which is
# not known here — and the Bridge token is shared with MLS sync and the criteria
# searches. Raise only after reviewing `explore_provider` telemetry.
EXPLORE_PROVIDER_GLOBAL_HOURLY=300
EXPLORE_PROVIDER_GLOBAL_DAILY=2000

# Ceiling per actor (`user id, else IP` — the identity every throttled route
# here already uses, hashed before it becomes a cache key). Nothing new is
# fingerprinted.
EXPLORE_PROVIDER_ACTOR_HOURLY=60
EXPLORE_PROVIDER_ACTOR_DAILY=300

# The Google 3D renderer's own switch. DEFAULT OFF.
#
# Google needs ALL THREE: EXPLORE_ENABLED, this switch, and
# EXPLORE_GOOGLE_MAPS_BROWSER_KEY. A key on its own turns nothing on.
#
# OFF MEANS THE LOADER NEVER RUNS: no <script> is inserted, maps.googleapis.com
# is never contacted, and the browser credential is not even emitted into the
# HTML. It is also the emergency stop for Google — no key deletion needed.
#
# ON only for `true`, `1`, `on`, `yes`. OFF for unset, empty, `false`, `0`,
# `off`, `no` — and anything else.
# See docs/explore-google-cloud-launch-checklist.md before switching it on.
EXPLORE_GOOGLE_3D_ENABLED=false
